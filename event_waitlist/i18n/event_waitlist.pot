#. module: event_waitlist
#: model:mail.template,body_html:event_waitlist.mail_template_waitlist_confirmed
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"                <p>Hello <t t-out=\"object.name or ''\">Alex</t>,</p>\n"
"                <p>\n"
"        you moved up from the waiting list and are now registered for\n"
"        <strong t-out=\"object.event_id.name or ''\">Yoga Basics</strong>\n"
"        (<t t-out=\"object.seats or ''\">1</t> seat(s)).\n"
"    </p>\n"
"                <p t-if=\"object.event_id.date_begin\">\n"
"        Start:\n"
"        <t t-out=\"object.event_id.date_begin\" t-options=\"{'widget': 'datetime', 'tz_name': object.event_id.date_tz}\">01/01/2026 18:00</t>\n"
"        <t t-if=\"object.event_id.address_id\">,\n"
"            <t t-out=\"object.event_id.address_id.display_name or ''\">Studio</t>\n"
"        </t>\n"
"    </p>\n"
"                <p>See you there!</p>\n"
"                <p style=\"color: #888; font-size: 12px; margin-top: 24px;\">\n"
"                    <a t-att-href=\"object._get_portal_url()\">View my entry</a>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

